{
  "name": "@the-groots/medusa-erpnext-subscriber",
  "version": "0.1.0",
  "description": "Medusa v2 subscriber that forwards order/fulfillment/return events to the ERPNext ecommerce_integrations connector.",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./subscriber": {
      "types": "./dist/subscribers/erpnext-sync.d.ts",
      "default": "./dist/subscribers/erpnext-sync.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "@medusajs/framework": "^2.4.0",
    "@medusajs/medusa": "^2.4.0"
  },
  "devDependencies": {
    "@medusajs/framework": "2.4.0",
    "@types/node": "20.17.7",
    "typescript": "5.6.3",
    "@medusajs/medusa": "2.4.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kiegsgroot/ecommerce_integrations.git",
    "directory": "ecommerce_integrations/medusa/medusa_subscriber"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  }
}
